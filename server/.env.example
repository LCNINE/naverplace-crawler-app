# Supabase 설정 (필수)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...

# 워커 설정 (JSON 배열, 필수)
# keyword: 검색어, mode: "all_korea" | "single"
# table: 워커별 저장 테이블 (필수)
# autoRestart: true = 전국 완주 후 자동 재시작
# slowMo: 요청 딜레이(ms), collectMenu: 대표메뉴 수집 여부
WORKERS=[{"keyword":"맛집","mode":"all_korea","table":"places_food","autoRestart":true,"slowMo":0,"collectMenu":false},{"keyword":"카페","mode":"all_korea","table":"places_cafe","autoRestart":true,"slowMo":0,"collectMenu":false}]

# Google Chat 알림 웹훅 (선택)
CHAT_WEBHOOK_URL=https://chat.googleapis.com/v1/spaces/...

# 서버 설정
PORT=3000

# 크롤러 데이터 저장 경로 (기본: ./data)
DATA_DIR=./data
